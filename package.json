{
  "name": "hermes-agent",
  "version": "1.0.0",
  "description": "An AI agent with advanced tool-calling capabilities, featuring a flexible toolsets system for organizing and managing tools.",
  "private": true,
  "workspaces": [
    "apps/*",
    "ui-tui",
    "ui-tui/packages/*",
    "web",
    "tests-js"
  ],
  "scripts": {
    "postinstall": "echo '\u2705 Node dependencies installed. Run: python run_agent.py --help'",
    "install:root": "npm install --workspaces=false",
    "install:web": "npm install --workspace web",
    "install:tui": "npm install --workspace ui-tui",
    "install:desktop": "npm install --workspace apps/desktop",
    "audit:root": "npm audit --workspaces=false",
    "audit:web": "npm audit --workspace web",
    "audit:tui": "npm audit --workspace ui-tui",
    "audit:fix:root": "npm audit fix --workspaces=false",
    "audit:fix:web": "npm audit fix --workspace web",
    "audit:fix:tui": "npm audit fix --workspace ui-tui",
    "check": "npm run --ws check",
    "fix": "npm run --ws fix",
    "prepare": "node -e \"const {existsSync}=require('fs');const {spawnSync}=require('child_process');if(existsSync('.git'))spawnSync('lefthook',['install'],{stdio:'inherit',shell:true})\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NousResearch/Hermes-Agent.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/NousResearch/Hermes-Agent/issues"
  },
  "homepage": "https://github.com/NousResearch/Hermes-Agent#readme",
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "10.12.0",
    "eslint-plugin-perfectionist": "5.12.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "17.13.0",
    "lefthook": "2.2.1",
    "minimatch": "https://github.com/matttest0080-prog/minimatch-hermes-compat/releases/download/v10.2.7-hermes.1/hermes-iot-minimatch-compat-10.2.7-hermes.1.tgz",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  },
  "overrides": {
    "@electron/osx-sign": {
      "isbinaryfile": "5.0.7"
    },
    "lodash": "4.18.1",
    "yauzl": "^3.3.1",
    "protobufjs": "^8.7.1",
    "axios": "1.20.0",
    "brace-expansion": "5.0.12",
    "mermaid": "11.16.1",
    "dompurify": "3.4.17",
    "electron": "44.9.3",
    "http-cache-semantics": "4.3.0",
    "ip-address": "10.7.4",
    "katex": "0.19.0",
    "nanoid@^3": "3.3.20",
    "nanoid@^6": "6.0.2",
    "js-yaml@^4": "4.3.2",
    "@simple-git/argv-parser": "2.0.1",
    "@vitest/mocker@^4": "4.1.12",
    "@xmldom/xmldom@^0.8": "0.8.15",
    "@xmldom/xmldom@^0.9": "0.9.12",
    "baseline-browser-mapping": "2.11.0",
    "browserslist@^4": "4.28.7",
    "colord@^2": "2.9.4",
    "fast-uri@^3": "3.1.9",
    "joi@^18": "18.3.1",
    "glob@>=9": "14.0.2",
    "path-scurry@^3": "3.0.0",
    "@isaacs/nonrecursive-glob-match": "1.0.1",
    "minimatch@<11": "$minimatch",
    "minimatch@>=11": "11.0.1",
    "postcss": {
      ".": "8.5.29",
      "nanoid": "3.3.20"
    },
    "postcss-selector-parser": "7.1.6",
    "rolldown@^1": "1.2.1",
    "sanitize-html@^2": "2.18.1",
    "shell-quote": "1.12.0",
    "simple-git": "4.0.2",
    "source-map-js": "1.2.2",
    "follow-redirects": "1.16.2",
    "zod@^4": "4.6.7",
    "tar": "7.5.22",
    "undici@^6": "6.29.1",
    "undici@^7": "7.30.1",
    "vitest@^4": "4.1.12",
    "yaml@^2": "2.9.1"
  },
  "engines": {
    "node": ">=26",
    "npm": "<11.10.0 || >=11.17.0"
  },
  "allowScripts": {
    "unicode-animations": false,
    "esbuild@0.28.2": true,
    "node-pty@1.1.0": true,
    "electron-winstaller@5.4.0": true,
    "electron@44.9.3": true,
    "fsevents@2.3.3": true,
    "get-windows@9.3.0": true,
    "lefthook@2.2.1": true
  },
  "dependencies": {
    "js-yaml": "4.3.2",
    "semver": "7.7.4"
  }
}
